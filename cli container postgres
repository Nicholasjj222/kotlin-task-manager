-- =========================================
--  Color System Database
-- =========================================

CREATE DATABASE colorsystem;

-- Use database
\c colorsystem;

-- =========================================
-- Table: palettes
-- =========================================
CREATE TABLE palettes (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    description TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- =========================================
-- Table: colors
-- =========================================
CREATE TABLE colors (
    id SERIAL PRIMARY KEY,
    palette_id INT REFERENCES palettes(id) ON DELETE CASCADE,
    name VARCHAR(50),
    hex_code VARCHAR(7) NOT NULL, -- e.g. #FF5733
    rgb_value VARCHAR(20),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

